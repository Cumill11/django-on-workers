{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "django-on-workers",
  "main": "src/index.py",
  "compatibility_flags": [
    "python_workers"
  ],
  "compatibility_date": "2025-11-25",
  "assets": {
    "directory": "./staticfiles"
  },
  "build": {
    "command": "WORKERS_CI=1 python src/manage.py collectstatic --noinput"
  },
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/__pycache__",
      "**/*.po",
      "**/*.css",
      "**/*.js",
      "**/*.svg",
      "**/*.png",
      "**/*.jpg"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "django-on-workers",
      "database_id": "0df3ec33-2cdf-4fb2-a5b8-dcb90ab37893"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "django-on-workers",
      "preview_bucket_name": "django-on-workers"
    }
  ]
}
